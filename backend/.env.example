# Application
APP_NAME="Smart Agri Copilot API"
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/smart_agri_copilot
# Echo raw SQL statements to the console (debug only)
DB_ECHO=false

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173"]

# Gemini — Google's official SDK (google-genai). Powers the AI assistant chat
# and leaf-scan image diagnosis. Backend only — never exposed to the frontend.
# Create a key at https://aistudio.google.com/apikey and paste it here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Model availability depends on the key's Google Cloud project. If you get
# HTTP 502 "Gemini model ... not found", switch GEMINI_MODEL to an id your key
# can still use (verified alternatives: gemini-3.5-flash, gemini-3.8-flash).

# Weather — WeatherAPI.com forecast provider (leave empty to disable)
WEATHER_API_KEY=""
WEATHER_API_BASE="https://api.weatherapi.com/v1"

# JWT authentication (generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password-reset tokens
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Email / transactional-mail (provider: "console" | "smtp" | "none")
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@smartagri.local"
# SMTP settings (only needed when EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true

# Frontend origin (used to build password-reset URLs)
FRONTEND_URL="http://localhost:5173"
